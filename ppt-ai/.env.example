# Copy to .env and fill in. Variables marked (required) must be set for the
# app to start; everything else is optional and turns a feature off when unset.
# Set SKIP_ENV_VALIDATION=1 to skip validation (e.g. Docker/CI builds).

# ── Core ───────────────────────────────────────────────────────────────
# (required) PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/pptai"

# (required) Public base URL of the app, used for auth callbacks and PayPal return URLs
NEXTAUTH_URL="http://localhost:3000"
# (required in production) Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ── Auth: Google OAuth (required) ──────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Admin dashboard ────────────────────────────────────────────────────
# Comma-separated list of admin emails
ADMIN_EMAILS=""
# Password for the admin credentials login (min 12 chars). Admin login is disabled when unset.
ADMIN_PASSWORD=""

# ── AI & content (required) ───────────────────────────────────────────
OPENAI_API_KEY=""
TOGETHER_AI_API_KEY=""
TAVILY_API_KEY=""
UNSPLASH_ACCESS_KEY=""
# Allow the Ollama / LM Studio providers in production ("true" | "false")
ALLOW_LOCAL_MODELS=""

# ── File uploads ───────────────────────────────────────────────────────
UPLOADTHING_TOKEN=""

# ── Billing: PayPal (required) ─────────────────────────────────────────
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# "sandbox" or "live"
PAYPAL_MODE="sandbox"
# Webhook ID from the PayPal dashboard. Webhooks are rejected without it.
PAYPAL_WEBHOOK_ID=""
# Only used by scripts/create-paypal-plans.ts
PAYPAL_PRODUCT_ID=""

# ── Rate limiting: Upstash Redis (strongly recommended in production) ──
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Email: Resend ──────────────────────────────────────────────────────
RESEND_API_KEY=""
# Where enterprise "contact sales" leads are sent (falls back to ADMIN_EMAILS)
SALES_EMAIL=""

# ── Observability ──────────────────────────────────────────────────────
SENTRY_DSN=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# ── Analytics & SEO ────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
